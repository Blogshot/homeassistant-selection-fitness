    "backdated_sent_title": {
      "message": "Selection Fitness: peso actual sobrescrito"
    },
    "backdated_sent": {
      "message": "Se ha enviado la medición con fecha anterior del {measured_at}. El servidor ha **sobrescrito el peso actual del perfil**. Vuelve a introducir tu peso actual, p. ej. con `selection_fitness.add_body_measurement` y la hora de la medición más reciente."
    }
