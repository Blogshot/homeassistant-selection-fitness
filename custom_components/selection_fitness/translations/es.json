          "name": "Altura",
          "description": "Altura en cm (por defecto: altura del perfil)."
        },
        "force_backdate": {
          "name": "Forzar fecha anterior",
          "description": "Enviar valores más antiguos que la medición más reciente. Atención: el servidor sobrescribe entonces el peso actual del perfil y habrá que introducirlo de nuevo."
        }
      }
    },
    "add_cardio_measurement": {
      "name": "Enviar medición cardiovascular",
      "description": "Escribe frecuencia cardíaca en reposo, presión arterial y/o VO2max con la hora de medición en la cuenta de Selection Fitness. Las entradas no se pueden eliminar después.",
