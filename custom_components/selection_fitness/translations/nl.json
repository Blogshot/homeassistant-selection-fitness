    },
    "send_failed": {
      "message": "De meting kon niet worden verzonden: {error}"
    },
    "backdated_sent_title": {
      "message": "Selection Fitness: huidig gewicht overschreven"
    },
    "backdated_sent": {
      "message": "De teruggedateerde meting van {measured_at} is verzonden. De server heeft **het huidige gewicht in het profiel overschreven**. Voer je huidige gewicht opnieuw in, bijv. met `selection_fitness.add_body_measurement` en het tijdstip van de nieuwste meting."
    }
  }
