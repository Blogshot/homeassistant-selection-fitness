  "services": {
    "add_body_measurement": {
      "name": "Lichaamsmeting verzenden",
      "description": "Schrijft gewicht, vetpercentage en/of lengte met meettijdstip naar het Selection Fitness-account. Items kunnen achteraf niet worden verwijderd.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Alleen nodig als er meerdere accounts zijn geconfigureerd."
        },
        "measured_at": {
          "name": "Gemeten op",
          "description": "Tijdstip van de meting (standaard: nu)."
        },
        "weight": {
          "name": "Gewicht",
          "description": "Lichaamsgewicht in kg."
        },
        "body_fat": {
          "name": "Vetpercentage",
          "description": "Lichaamsvetpercentage."
        },
        "height": {
          "name": "Lengte",
          "description": "Lengte in cm (standaard: lengte uit het profiel)."
        },
        "force_backdate": {
          "name": "Terugdateren afdwingen",
          "description": "Waarden verzenden die ouder zijn dan de nieuwste meting. Let op: de server overschrijft dan het huidige gewicht in het profiel – dat moet daarna opnieuw worden ingevoerd."
        }
      }
    },
    "add_cardio_measurement": {
      "name": "Cardiometing verzenden",
      "description": "Schrijft rusthartslag, bloeddruk en/of VO2max met meettijdstip naar het Selection Fitness-account. Items kunnen achteraf niet worden verwijderd.",
