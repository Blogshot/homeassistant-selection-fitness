        "config_entry_id": {
          "name": "Compte",
          "description": "Uniquement nécessaire si plusieurs comptes sont configurés."
        },
        "measured_at": {
          "name": "Mesuré le",
          "description": "Heure de la mesure (par défaut : maintenant)."
        },
        "weight": {
          "name": "Poids",
          "description": "Poids corporel en kg."
        },
        "body_fat": {
          "name": "Masse grasse",
          "description": "Pourcentage de masse grasse."
        },
        "height": {
          "name": "Taille",
          "description": "Taille en cm (par défaut : taille du profil)."
        },
        "force_backdate": {
          "name": "Forcer l'antidatage",
          "description": "Envoyer des valeurs plus anciennes que la mesure la plus récente. Attention : le serveur écrase alors le poids actuel du profil, qu'il faudra saisir à nouveau."
        }
      }
    },
    "add_cardio_measurement": {
      "name": "Envoyer une mesure cardio",
      "description": "Enregistre la fréquence cardiaque au repos, la pression artérielle et/ou la VO2max avec l'heure de mesure dans le compte Selection Fitness. Les entrées ne peuvent pas être supprimées ensuite.",
      "fields": {
        "config_entry_id": {
          "name": "Compte",
          "description": "Uniquement nécessaire si plusieurs comptes sont configurés."
        },
        "measured_at": {
          "name": "Mesuré le",
          "description": "Heure de la mesure (par défaut : maintenant)."
        },
        "resting_heart_rate": {
          "name": "Fréquence cardiaque au repos",
          "description": "Fréquence cardiaque au repos en battements par minute."
        },
        "systolic": {
          "name": "Pression artérielle systolique",
          "description": "Pression artérielle systolique en mmHg (uniquement avec la diastolique)."
        },
        "diastolic": {
          "name": "Pression artérielle diastolique",
          "description": "Pression artérielle diastolique en mmHg (uniquement avec la systolique)."
        },
        "vo2max": {
          "name": "VO2max",
          "description": "Consommation maximale d'oxygène en ml/kg/min."
