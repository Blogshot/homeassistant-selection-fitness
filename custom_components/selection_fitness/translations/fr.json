  "services": {
    "add_body_measurement": {
      "name": "Envoyer une mesure corporelle",
      "description": "Enregistre le poids, la masse grasse et/ou la taille avec l'heure de mesure dans le compte Selection Fitness. Les entrées ne peuvent pas être supprimées ensuite.",
