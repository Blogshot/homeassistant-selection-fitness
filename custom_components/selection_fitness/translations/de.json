  "services": {
    "add_body_measurement": {
      "name": "Körpermesswert senden",
      "description": "Schreibt Gewicht, Körperfett und/oder Größe mit Messzeitpunkt ins Selection-Fitness-Konto. Einträge lassen sich nicht wieder löschen.",
      "fields": {
        "config_entry_id": {
          "name": "Konto",
          "description": "Nur nötig, wenn mehrere Konten eingerichtet sind."
        },
        "measured_at": {
          "name": "Messzeitpunkt",
          "description": "Zeitpunkt der Messung (Standard: jetzt)."
        },
        "weight": {
          "name": "Gewicht",
          "description": "Körpergewicht in kg."
        },
        "body_fat": {
          "name": "Körperfett",
          "description": "Körperfettanteil in %."
        },
        "height": {
          "name": "Größe",
          "description": "Körpergröße in cm (Standard: Größe aus dem Profil)."
        },
        "force_backdate": {
          "name": "Rückwirkend erzwingen",
          "description": "Werte senden, die älter als die neueste Messung sind. Achtung: Der Server überschreibt damit das aktuelle Gewicht im Profil – es muss danach neu eingetragen werden."
        }
      }
    },
    "add_cardio_measurement": {
      "name": "Cardio-Messwert senden",
      "description": "Schreibt Ruhepuls, Blutdruck und/oder VO2max mit Messzeitpunkt ins Selection-Fitness-Konto. Einträge lassen sich nicht wieder löschen.",
      "fields": {
        "config_entry_id": {
          "name": "Konto",
          "description": "Nur nötig, wenn mehrere Konten eingerichtet sind."
        },
        "measured_at": {
          "name": "Messzeitpunkt",
          "description": "Zeitpunkt der Messung (Standard: jetzt)."
        },
        "resting_heart_rate": {
          "name": "Ruhepuls",
          "description": "Ruhepuls in Schlägen pro Minute."
        },
        "systolic": {
          "name": "Blutdruck systolisch",
          "description": "Systolischer Blutdruck in mmHg (nur zusammen mit diastolisch)."
        },
        "diastolic": {
          "name": "Blutdruck diastolisch",
          "description": "Diastolischer Blutdruck in mmHg (nur zusammen mit systolisch)."
        },
        "vo2max": {
          "name": "VO2max",
          "description": "Maximale Sauerstoffaufnahme in ml/kg/min."
