    "backdated_rejected": {
      "message": "measured_at ({measured_at}) liegt vor der neuesten Messung ({newest}). Der Server würde damit das aktuelle Gewicht im Profil überschreiben. Zum bewussten Nachtragen force_backdate: true setzen und danach das aktuelle Gewicht neu eintragen."
    },
    "send_failed": {
      "message": "Der Messwert konnte nicht gesendet werden: {error}"
    },
    "backdated_sent_title": {
      "message": "Selection Fitness: aktuelles Gewicht überschrieben"
    },
    "backdated_sent": {
      "message": "Der rückwirkende Messwert vom {measured_at} wurde gesendet. Dabei hat der Server das **aktuelle Gewicht im Profil überschrieben**. Bitte das aktuelle Gewicht neu eintragen, z. B. mit `selection_fitness.add_body_measurement` und dem Zeitpunkt der neuesten Messung."
    }
  }
