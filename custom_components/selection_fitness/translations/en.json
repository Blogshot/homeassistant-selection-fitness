      "message": "Several Selection Fitness accounts are set up – please specify config_entry_id."
    },
    "measured_at_in_future": {
      "message": "measured_at must not be in the future."
    },
    "body_value_required": {
      "message": "Specify weight or body_fat."
    },
    "cardio_value_required": {
      "message": "Specify at least one measurement."
    },
    "blood_pressure_incomplete": {
      "message": "Blood pressure needs both systolic and diastolic."
    },
    "backdated_rejected": {
      "message": "measured_at ({measured_at}) is before the newest measurement ({newest}). The server would overwrite the current weight in the profile. To backdate on purpose, set force_backdate: true and enter the current weight again afterwards."
    },
    "send_failed": {
      "message": "The measurement could not be sent: {error}"
    },
    "backdated_sent_title": {
      "message": "Selection Fitness: current weight overwritten"
    },
    "backdated_sent": {
      "message": "The backdated measurement from {measured_at} has been sent. The server has **overwritten the current weight in the profile**. Please enter your current weight again, e.g. with `selection_fitness.add_body_measurement` and the time of the newest measurement."
    },
    "unknown_exercise": {
      "message": "Exercise \"{exercise}\" was not found in the eGym catalog. Use the exact name or the exercise code."
    },
    "reps_or_duration_required": {
      "message": "This exercise needs repetitions or a duration per set."
    },
    "duration_required": {
      "message": "This exercise needs a duration."
    }
  }
