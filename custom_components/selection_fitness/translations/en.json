  "services": {
    "add_body_measurement": {
      "name": "Send body measurement",
      "description": "Writes weight, body fat and/or height with a measurement time to the Selection Fitness account. Entries cannot be deleted afterwards.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only required if several accounts are configured."
        },
        "measured_at": {
          "name": "Measured at",
          "description": "Time of the measurement (default: now)."
        },
        "weight": {
          "name": "Weight",
          "description": "Body weight in kg."
        },
        "body_fat": {
          "name": "Body fat",
          "description": "Body fat percentage."
        },
        "height": {
          "name": "Height",
          "description": "Height in cm (default: height from the profile)."
        },
        "force_backdate": {
          "name": "Force backdating",
          "description": "Send values older than the newest measurement. Warning: the server then overwrites the current weight in the profile – it has to be entered again afterwards."
        }
      }
    },
    "add_cardio_measurement": {
      "name": "Send cardio measurement",
      "description": "Writes resting heart rate, blood pressure and/or VO2max with a measurement time to the Selection Fitness account. Entries cannot be deleted afterwards.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only required if several accounts are configured."
        },
        "measured_at": {
          "name": "Measured at",
          "description": "Time of the measurement (default: now)."
        },
        "resting_heart_rate": {
          "name": "Resting heart rate",
          "description": "Resting heart rate in beats per minute."
        },
        "systolic": {
          "name": "Blood pressure systolic",
          "description": "Systolic blood pressure in mmHg (only together with diastolic)."
        },
        "diastolic": {
          "name": "Blood pressure diastolic",
          "description": "Diastolic blood pressure in mmHg (only together with systolic)."
        },
        "vo2max": {
          "name": "VO2max",
          "description": "Maximal oxygen uptake in ml/kg/min."
        }
      }
    },
    "add_workout": {
      "name": "Log workout",
      "description": "Logs a manual workout with one exercise, like in the app. Calories and activity points are calculated by eGym. Entries can be deleted in the app.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only required if several accounts are configured."
        },
        "completed_at": {
          "name": "Completed at",
          "description": "Time of the workout (default: now)."
        },
        "exercise": {
          "name": "Exercise",
          "description": "Exact name from the eGym catalog or the exercise code, e.g. \"Crosstrainer\" or \"1460\"."
        },
        "sets": {
          "name": "Sets",
          "description": "Number of identical sets (default: 1)."
        },
        "reps": {
          "name": "Repetitions per set",
          "description": "Repetitions per set."
        },
        "weight": {
          "name": "Weight per set",
          "description": "Weight per set in kg."
        },
        "duration": {
          "name": "Duration",
          "description": "Per set for hold exercises, total duration for cardio and classes."
        },
        "distance": {
          "name": "Distance",
          "description": "Distance in km."
        },
        "calories": {
          "name": "Calories",
          "description": "Optional – otherwise calculated by eGym."
        },
        "set_list": {
          "name": "Individual sets",
          "description": "Sets with different values, e.g. [{\"reps\": 10, \"weight\": 40}, {\"reps\": 8, \"weight\": 45}]. Overrides sets, reps and weight."
        }
      }
    }
  },
