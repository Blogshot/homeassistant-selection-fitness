  "services": {
    "add_body_measurement": {
      "name": "身体測定値を送信",
      "description": "体重、体脂肪率、身長を測定日時とともに Selection Fitness アカウントに書き込みます。書き込んだ項目は後から削除できません。",
      "fields": {
        "config_entry_id": {
          "name": "アカウント",
          "description": "複数のアカウントを設定している場合のみ必要です。"
        },
        "measured_at": {
          "name": "測定日時",
          "description": "測定の日時（既定：現在）。"
        },
        "weight": {
          "name": "体重",
          "description": "体重（kg）。"
        },
        "body_fat": {
          "name": "体脂肪率",
          "description": "体脂肪率（%）。"
        },
        "height": {
          "name": "身長",
          "description": "身長（cm）（既定：プロフィールの身長）。"
        },
        "force_backdate": {
          "name": "過去日付を強制",
          "description": "最新の測定より古い値を送信します。注意：サーバーがプロフィールの現在の体重を上書きするため、後で入力し直す必要があります。"
        }
      }
    },
    "add_cardio_measurement": {
      "name": "心肺測定値を送信",
      "description": "安静時心拍数、血圧、最大酸素摂取量を測定日時とともに Selection Fitness アカウントに書き込みます。書き込んだ項目は後から削除できません。",
      "fields": {
        "config_entry_id": {
          "name": "アカウント",
          "description": "複数のアカウントを設定している場合のみ必要です。"
        },
        "measured_at": {
          "name": "測定日時",
          "description": "測定の日時（既定：現在）。"
        },
        "resting_heart_rate": {
          "name": "安静時心拍数",
          "description": "安静時心拍数（拍/分）。"
        },
        "systolic": {
          "name": "最高血圧",
          "description": "最高血圧（mmHg、最低血圧と一緒にのみ）。"
        },
        "diastolic": {
          "name": "最低血圧",
          "description": "最低血圧（mmHg、最高血圧と一緒にのみ）。"
        },
        "vo2max": {
          "name": "最大酸素摂取量",
          "description": "最大酸素摂取量（ml/kg/min）。"
        }
      }
    }
