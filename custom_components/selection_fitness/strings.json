  "services": {
    "add_body_measurement": {
      "name": "Send body measurement",
      "description": "Writes weight, body fat and/or height with a measurement time to the Selection Fitness account. Entries cannot be deleted afterwards.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only required if several accounts are configured."
        },
        "measured_at": {
          "name": "Measured at",
          "description": "Time of the measurement (default: now)."
        },
        "weight": {
          "name": "Weight",
          "description": "Body weight in kg."
        },
        "body_fat": {
          "name": "Body fat",
          "description": "Body fat percentage."
        },
        "height": {
          "name": "Height",
          "description": "Height in cm (default: height from the profile)."
        },
        "force_backdate": {
          "name": "Force backdating",
          "description": "Send values older than the newest measurement. Warning: the server then overwrites the current weight in the profile – it has to be entered again afterwards."
        }
      }
    },
    "add_cardio_measurement": {
      "name": "Send cardio measurement",
      "description": "Writes resting heart rate, blood pressure and/or VO2max with a measurement time to the Selection Fitness account. Entries cannot be deleted afterwards.",
      "fields": {
        "config_entry_id": {
          "name": "Account",
          "description": "Only required if several accounts are configured."
        },
        "measured_at": {
          "name": "Measured at",
          "description": "Time of the measurement (default: now)."
        },
        "resting_heart_rate": {
          "name": "Resting heart rate",
          "description": "Resting heart rate in beats per minute."
        },
        "systolic": {
          "name": "Blood pressure systolic",
          "description": "Systolic blood pressure in mmHg (only together with diastolic)."
        },
        "diastolic": {
          "name": "Blood pressure diastolic",
          "description": "Diastolic blood pressure in mmHg (only together with systolic)."
        },
        "vo2max": {
          "name": "VO2max",
          "description": "Maximal oxygen uptake in ml/kg/min."
        }
      }
    }
  },
